<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.app.controllers.PersonnelController"
      spacing="16.0">

    <!-- Top Filter Bar: Instant Keyword Search + Role Filter ComboBox -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
        <TextField fx:id="searchField"
                   promptText="Instant search by ID, full name, phone, or specialty/shift..."
                   HBox.hgrow="ALWAYS"
                   styleClass="search-field"/>

        <ComboBox fx:id="roleFilterComboBox"
                  prefWidth="185.0"
                  minWidth="165.0"
                  promptText="Filter by Role"
                  styleClass="form-combo"/>

        <Button text="Reset"
                onAction="#handleResetFilters"
                styleClass="secondary-button"/>
    </HBox>

    <!-- Non-Blocking Feedback Banner -->
    <Label fx:id="feedbackBanner"
           text=""
           managed="false"
           visible="false"
           maxWidth="Infinity"
           wrapText="true"/>

    <!-- Split-Pane Layout: Left/Center Personnel TableView + Right CRUD Form -->
    <SplitPane dividerPositions="0.65"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: transparent; -fx-padding: 0;">

        <!-- Left / Center Pane: Personnel Directory Table -->
        <VBox spacing="12.0" minWidth="470.0" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Personnel Directory" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="personnelCountLabel"
                       text="Showing 0 of 0 personnel"
                       styleClass="card-subtitle"/>
            </HBox>

            <TableView fx:id="personnelTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID"
                                 minWidth="92.0" prefWidth="100.0"/>
                    <TableColumn fx:id="nameColumn" text="Full Name"
                                 minWidth="145.0" prefWidth="165.0"/>
                    <TableColumn fx:id="positionColumn" text="Position"
                                 minWidth="125.0" prefWidth="135.0"/>
                    <TableColumn fx:id="phoneColumn" text="Phone"
                                 minWidth="110.0" prefWidth="120.0"/>
                    <TableColumn fx:id="specialtyShiftColumn" text="Specialty / Shift"
                                 minWidth="175.0" prefWidth="210.0"/>
                    <TableColumn fx:id="payRateColumn" text="Pay Rate"
                                 minWidth="125.0" prefWidth="135.0"/>
                    <TableColumn fx:id="statusColumn" text="Status"
                                 minWidth="105.0" prefWidth="115.0"/>
                </columns>
                <placeholder>
                    <Label text="No matching staff or personal trainers found."
                           styleClass="card-subtitle"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Right Pane: Personnel Details & CRUD Form -->
        <VBox minWidth="320.0" prefWidth="370.0" spacing="12.0" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Personnel Details" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="formModeBadge"
                       text="NO SELECTION"
                       styleClass="badge-neutral"/>
                <Button fx:id="newPersonnelButton"
                        text="+ New"
                        onAction="#handleNewPersonnel"
                        styleClass="secondary-button"
                        style="-fx-padding: 5px 11px; -fx-font-size: 12px;"/>
            </HBox>

            <Separator/>

            <!-- Empty State Placeholder when no row is selected and not in Create mode -->
            <VBox fx:id="emptyFormBox"
                  alignment="CENTER_LEFT"
                  spacing="12.0"
                  VBox.vgrow="ALWAYS">
                <Label text="Select a staff member or personal trainer from the table to inspect or edit their record, or create a new personnel profile."
                       wrapText="true"
                       styleClass="card-subtitle"/>
                <Button text="+ New Personnel"
                        onAction="#handleNewPersonnel"
                        styleClass="action-primary-button"/>
            </VBox>

            <!-- Scrollable Form Container for Create (FR-25), Update (FR-26), and Delete (FR-27) -->
            <ScrollPane fx:id="formScrollPane"
                        fitToWidth="true"
                        managed="false"
                        visible="false"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                <VBox spacing="10.0" style="-fx-padding: 2 4 6 2;">

                    <!-- Read-only Auto-Generated / Assigned Personnel ID -->
                    <VBox spacing="3.0">
                        <Label text="PERSONNEL ID" styleClass="detail-label"/>
                        <TextField fx:id="formPersonnelIdField"
                                   editable="false"
                                   focusTraversable="false"
                                   styleClass="input-field"
                                   style="-fx-background-color: #f8fafc; -fx-text-fill: #667085;"/>
                    </VBox>

                    <!-- Full Name + Inline Error State -->
                    <VBox spacing="3.0">
                        <Label text="FULL NAME *" styleClass="detail-label"/>
                        <TextField fx:id="formFullNameField"
                                   promptText="e.g. Nguyen Van An"
                                   styleClass="input-field"/>
                        <Label fx:id="nameErrorLabel"
                               text=""
                               managed="false"
                               visible="false"
                               wrapText="true"
                               styleClass="validation-message"
                               style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Position & Status Row -->
                    <HBox spacing="10.0">
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label text="POSITION *" styleClass="detail-label"/>
                            <ComboBox fx:id="formPositionComboBox"
                                      maxWidth="Infinity"
                                      promptText="Select position"
                                      styleClass="form-combo"/>
                            <Label fx:id="positionErrorLabel"
                                   text=""
                                   managed="false"
                                   visible="false"
                                   wrapText="true"
                                   styleClass="validation-message"
                                   style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                        </VBox>

                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label text="STATUS *" styleClass="detail-label"/>
                            <ComboBox fx:id="formStatusComboBox"
                                      maxWidth="Infinity"
                                      promptText="Select status"
                                      styleClass="form-combo"/>
                            <Label fx:id="statusErrorLabel"
                                   text=""
                                   managed="false"
                                   visible="false"
                                   wrapText="true"
                                   styleClass="validation-message"
                                   style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Phone & Pay Rate Row -->
                    <HBox spacing="10.0">
                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label text="PHONE *" styleClass="detail-label"/>
                            <TextField fx:id="formPhoneField"
                                       promptText="e.g. 0901234567"
                                       styleClass="input-field"/>
                            <Label fx:id="phoneErrorLabel"
                                   text=""
                                   managed="false"
                                   visible="false"
                                   wrapText="true"
                                   styleClass="validation-message"
                                   style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                        </VBox>

                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <Label text="PAY RATE (VND/HR) *" styleClass="detail-label"/>
                            <TextField fx:id="formPayRateField"
                                       promptText="e.g. 150000"
                                       styleClass="input-field"/>
                            <Label fx:id="payRateErrorLabel"
                                   text=""
                                   managed="false"
                                   visible="false"
                                   wrapText="true"
                                   styleClass="validation-message"
                                   style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Optional Email Field -->
                    <VBox spacing="3.0">
                        <Label text="EMAIL" styleClass="detail-label"/>
                        <TextField fx:id="formEmailField"
                                   promptText="e.g. name@gym.vn"
                                   styleClass="input-field"/>
                        <Label fx:id="emailErrorLabel"
                               text=""
                               managed="false"
                               visible="false"
                               wrapText="true"
                               styleClass="validation-message"
                               style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Conditional Field: Shown & Enabled ONLY when Position == "Personal Trainer" -->
                    <VBox fx:id="specialtyFieldContainer"
                          spacing="3.0"
                          managed="false"
                          visible="false">
                        <Label text="SPECIALTY *" styleClass="detail-label"/>
                        <TextField fx:id="formSpecialtyShiftField"
                                   disable="true"
                                   promptText="e.g. Strength &amp; Hypertrophy"
                                   styleClass="input-field"/>
                        <Label fx:id="specialtyErrorLabel"
                               text=""
                               managed="false"
                               visible="false"
                               wrapText="true"
                               styleClass="validation-message"
                               style="-fx-padding: 1 0 0 0; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Form-Level Summary Validation Message -->
                    <Label fx:id="formValidationLabel"
                           text=""
                           managed="false"
                           visible="false"
                           wrapText="true"
                           styleClass="validation-message"/>

                    <!-- Right-Hand Form CRUD Actions -->
                    <VBox spacing="8.0" style="-fx-padding: 6 0 0 0;">
                        <HBox spacing="10.0">
                            <Button fx:id="clearFormButton"
                                    text="Clear Form"
                                    onAction="#handleClearForm"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"/>

                            <Button fx:id="saveButton"
                                    text="Save"
                                    onAction="#handleSavePersonnel"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="action-primary-button"/>
                        </HBox>

                        <Button fx:id="deleteButton"
                                text="Deactivate / Delete Record"
                                onAction="#handleDeletePersonnel"
                                managed="false"
                                visible="false"
                                disable="true"
                                maxWidth="Infinity"
                                styleClass="danger-button"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>

    </SplitPane>
</VBox>