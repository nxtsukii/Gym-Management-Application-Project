<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gym.app.controllers.LoginController"
           styleClass="app-background">
    <VBox alignment="CENTER_LEFT" maxWidth="420.0" maxHeight="-Infinity" spacing="0.0" styleClass="login-card">
        <padding>
            <Insets top="28.0" right="38.0" bottom="26.0" left="38.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <StackPane minWidth="38.0" minHeight="38.0" maxWidth="38.0" maxHeight="38.0" styleClass="brand-mark">
                <Label text="G" styleClass="brand-mark-text"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label text="GYM MANAGEMENT" styleClass="brand-name"/>
                <Label text="STAFF &amp; OWNER PORTAL" styleClass="brand-caption"/>
            </VBox>
        </HBox>

        <Region minHeight="22.0" prefHeight="22.0"/>

        <Label text="Welcome back" styleClass="screen-title"/>
        <Label text="Sign in to manage your gym." styleClass="screen-subtitle"/>

        <Region minHeight="18.0" prefHeight="18.0"/>

        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField"
                   promptText="Enter your username"
                   accessibleText="Username"
                   styleClass="input-field"/>

        <Region minHeight="12.0" prefHeight="12.0"/>

        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Enter your password"
                       accessibleText="Password"
                       styleClass="input-field"
                       onAction="#handleLogin"/>

        <Region minHeight="14.0" prefHeight="14.0"/>

        <Label fx:id="validationMessage"
               text=""
               managed="false"
               visible="false"
               wrapText="true"
               styleClass="validation-message"/>

        <Button fx:id="loginButton"
                text="Log in"
                maxWidth="Infinity"
                onAction="#handleLogin"
                styleClass="primary-button"/>

        <Region minHeight="16.0" prefHeight="16.0"/>
        <Separator/>
        <Region minHeight="12.0" prefHeight="12.0"/>

        <VBox spacing="8.0">
            <Label text="QUICK TEST CREDENTIALS" styleClass="demo-section-label"/>
            <HBox spacing="10.0">
                <Button fx:id="ownerDemoButton"
                        text="Owner Demo"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleOwnerQuickLogin"
                        styleClass="demo-role-button"/>
                <Button fx:id="staffDemoButton"
                        text="Staff Demo"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        onAction="#handleStaffQuickLogin"
                        styleClass="demo-role-button"/>
            </HBox>
        </VBox>
        
    </VBox>
</StackPane>
