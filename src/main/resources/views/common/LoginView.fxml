<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gym.app.controllers.LoginController"
           styleClass="app-background">
    <VBox alignment="CENTER_LEFT" maxWidth="420.0" spacing="0.0" styleClass="login-card">
        <padding>
            <Insets top="38.0" right="42.0" bottom="34.0" left="42.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <StackPane minWidth="38.0" minHeight="38.0" maxWidth="38.0" maxHeight="38.0" styleClass="brand-mark">
                <Label text="G" styleClass="brand-mark-text"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label text="GYM MANAGEMENT" styleClass="brand-name"/>
                <Label text="STAFF PORTAL" styleClass="brand-caption"/>
            </VBox>
        </HBox>

        <Region minHeight="32.0" prefHeight="32.0"/>

        <Label text="Welcome back" styleClass="screen-title"/>
        <Label text="Sign in to manage your gym." styleClass="screen-subtitle"/>

        <Region minHeight="27.0" prefHeight="27.0"/>

        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField"
                   promptText="Enter your username"
                   accessibleText="Username"
                   styleClass="input-field"/>

        <Region minHeight="17.0" prefHeight="17.0"/>

        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"
                       promptText="Enter your password"
                       accessibleText="Password"
                       styleClass="input-field"
                       onAction="#handleLogin"/>

        <Region minHeight="22.0" prefHeight="22.0"/>

        <Label fx:id="validationMessage"
               text=""
               managed="false"
               visible="false"
               wrapText="true"
               styleClass="validation-message"/>

        <Button text="Log in"
                maxWidth="Infinity"
                onAction="#handleLogin"
                styleClass="primary-button"/>

        <Region minHeight="27.0" prefHeight="27.0"/>

        <Label text="Authorized staff access only"
               maxWidth="Infinity"
               alignment="CENTER"
               styleClass="footer-note"/>
    </VBox>
</StackPane>
