<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gym.app.controllers.MainLayoutController"
            prefWidth="1200.0"
            prefHeight="760.0"
            styleClass="workspace-root">

    <!-- Persistent Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="248.0" minWidth="248.0" maxWidth="248.0" spacing="6.0" styleClass="sidebar">
            <!-- Brand Header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <StackPane minWidth="36.0" minHeight="36.0" maxWidth="36.0" maxHeight="36.0"
                           styleClass="sidebar-brand-mark">
                    <Label text="G" styleClass="sidebar-brand-mark-text"/>
                </StackPane>
                <VBox spacing="2.0">
                    <Label text="GYM SYSTEM" styleClass="sidebar-brand-name"/>
                    <Label text="MANAGEMENT PORTAL" styleClass="sidebar-brand-caption"/>
                </VBox>
            </HBox>

            <Region minHeight="16.0" prefHeight="16.0"/>

            <!-- Owner-Only Overview Route (Hidden & unmanaged for STAFF) -->
            <Button fx:id="dashboardBtn"
                    text="Dashboard &amp; Reports"
                    maxWidth="Infinity"
                    onAction="#handleShowDashboard"
                    styleClass="nav-button"/>

            <!-- Shared Operational Routes (Visible to both STAFF and OWNER) -->
            <Label fx:id="operationsSectionLabel"
                   text="OPERATIONS"
                   styleClass="sidebar-section-label"/>

            <Button fx:id="membersBtn"
                    text="Members"
                    maxWidth="Infinity"
                    onAction="#handleShowMembers"
                    styleClass="nav-button"/>

            <Button fx:id="membershipsBtn"
                    text="Memberships"
                    maxWidth="Infinity"
                    onAction="#handleShowMemberships"
                    styleClass="nav-button"/>

            <Button fx:id="paymentsBtn"
                    text="Payments"
                    maxWidth="Infinity"
                    onAction="#handleShowPayments"
                    styleClass="nav-button"/>

            <Button fx:id="checkInBtn"
                    text="Check-in"
                    maxWidth="Infinity"
                    onAction="#handleShowCheckIn"
                    styleClass="nav-button"/>

            <!-- Owner-Only Administration Routes (Hidden & unmanaged for STAFF) -->
            <Label fx:id="adminSectionLabel"
                   text="ADMINISTRATION"
                   styleClass="sidebar-section-label"/>

            <Button fx:id="personnelBtn"
                    text="Personnel"
                    maxWidth="Infinity"
                    onAction="#handleShowPersonnel"
                    styleClass="nav-button"/>

            <Button fx:id="equipmentBtn"
                    text="Equipment"
                    maxWidth="Infinity"
                    onAction="#handleShowEquipment"
                    styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Sidebar Workspace Status Footer -->
            <VBox spacing="3.0" styleClass="sidebar-footer">
                <Label text="Workspace Shell v1.0" styleClass="sidebar-user-name"/>
                <Label fx:id="sidebarScopeLabel"
                       text="Role-Based Access Enforced"
                       styleClass="sidebar-user-role"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center Shell: Top Header Bar + Dynamic StackPane Content Area -->
    <center>
        <VBox>
            <!-- Top Header Bar -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
                <!-- Dynamic Screen Title & Subtitle -->
                <VBox spacing="2.0">
                    <Label fx:id="headerTitleLabel"
                           text="Dashboard &amp; Reports"
                           styleClass="page-title"/>
                    <Label fx:id="headerSubtitleLabel"
                           text="Workspace overview"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Logged-in User Badge -->
                <HBox alignment="CENTER_LEFT" spacing="9.0" styleClass="user-badge">
                    <StackPane minWidth="28.0" minHeight="28.0" maxWidth="28.0" maxHeight="28.0"
                               styleClass="user-avatar-circle">
                        <Label fx:id="userInitialsLabel"
                               text="U"
                               styleClass="user-avatar-initials"/>
                    </StackPane>
                    <VBox spacing="1.0">
                        <Label fx:id="userBadgeLabel"
                               text="Authenticated User"
                               styleClass="user-badge-name"/>
                        <Label fx:id="userIdLabel"
                               text="USR-000"
                               styleClass="user-badge-id"/>
                    </VBox>
                </HBox>

                <!-- Role Chip (OWNER vs. STAFF) -->
                <Label fx:id="roleChipLabel"
                       text="Gym Staff"
                       styleClass="role-chip-staff"/>

                <!-- Logout Button (FR-05) -->
                <Button fx:id="logoutButton"
                        text="Log out"
                        onAction="#handleLogout"
                        styleClass="topbar-logout-button"/>
            </HBox>

            <!-- Dynamic Content Container -->
            <StackPane fx:id="contentArea"
                       VBox.vgrow="ALWAYS"
                       styleClass="content-area"/>
        </VBox>
    </center>

</BorderPane>