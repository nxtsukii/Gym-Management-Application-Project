<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.app.controllers.MemberFormDialogController"
      prefWidth="460.0"
      spacing="14.0"
      style="-fx-background-color: #ffffff; -fx-font-family: 'Segoe UI', 'Arial', sans-serif;">

    <padding>
        <Insets top="24.0" right="26.0" bottom="22.0" left="26.0"/>
    </padding>

    <VBox spacing="3.0">
        <Label fx:id="dialogTitleLabel" text="Add New Member" styleClass="page-title"/>
        <Label fx:id="dialogSubtitleLabel"
               text="Enter the member details below."
               styleClass="page-subtitle"/>
    </VBox>

    <VBox spacing="10.0">
        <VBox spacing="2.0">
            <Label text="Member ID" styleClass="field-label"/>
            <TextField fx:id="memberIdField"
                       editable="false"
                       focusTraversable="false"
                       styleClass="input-field"
                       style="-fx-background-color: #f8fafc; -fx-text-fill: #667085;"/>
        </VBox>

        <VBox spacing="2.0">
            <Label text="Full Name *" styleClass="field-label"/>
            <TextField fx:id="fullNameField"
                       promptText="e.g. Nguyen Van An"
                       styleClass="input-field"/>
        </VBox>

        <HBox spacing="12.0">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Phone *" styleClass="field-label"/>
                <TextField fx:id="phoneField"
                           promptText="e.g. 0901234567"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Email *" styleClass="field-label"/>
                <TextField fx:id="emailField"
                           promptText="e.g. an@email.com"
                           styleClass="input-field"/>
            </VBox>
        </HBox>

        <HBox spacing="12.0">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Membership Type *" styleClass="field-label"/>
                <ComboBox fx:id="typeComboBox"
                          maxWidth="Infinity"
                          styleClass="form-combo"/>
            </VBox>

            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Membership Status *" styleClass="field-label"/>
                <ComboBox fx:id="statusComboBox"
                          maxWidth="Infinity"
                          styleClass="form-combo"/>
            </VBox>
        </HBox>

        <VBox spacing="2.0">
            <Label text="Expiry Date *" styleClass="field-label"/>
            <DatePicker fx:id="expiryDatePicker"
                        editable="false"
                        maxWidth="Infinity"
                        styleClass="form-date-picker"/>
        </VBox>
    </VBox>

    <Label fx:id="validationLabel"
           text=""
           managed="false"
           visible="false"
           wrapText="true"
           styleClass="validation-message"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>
        <Button fx:id="saveButton"
                text="Save Member"
                onAction="#handleSave"
                styleClass="action-primary-button"/>
    </HBox>
</VBox>
