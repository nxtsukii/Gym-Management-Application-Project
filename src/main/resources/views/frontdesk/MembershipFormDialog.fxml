<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gym.app.controllers.MembershipFormDialogController"
      prefWidth="460.0"
      spacing="14.0"
      style="-fx-background-color: #ffffff; -fx-font-family: 'Segoe UI', 'Arial', sans-serif;">

    <padding>
        <Insets top="24.0" right="26.0" bottom="22.0" left="26.0"/>
    </padding>

    <VBox spacing="3.0">
        <Label fx:id="dialogTitleLabel"
               text="Add Membership Package"
               styleClass="page-title"/>
        <Label fx:id="dialogSubtitleLabel"
               text="Enter the new package details below."
               styleClass="page-subtitle"/>
    </VBox>

    <VBox spacing="10.0">
        <VBox spacing="2.0">
            <Label text="Package ID *" styleClass="field-label"/>
            <TextField fx:id="packageIdField"
                       promptText="e.g. PKG-005"
                       styleClass="input-field"/>
        </VBox>

        <VBox spacing="2.0">
            <Label text="Package Name *" styleClass="field-label"/>
            <TextField fx:id="packageNameField"
                       promptText="e.g. Weekend Plan"
                       styleClass="input-field"/>
        </VBox>

        <HBox spacing="12.0">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Duration (months) *" styleClass="field-label"/>
                <TextField fx:id="durationField"
                           promptText="e.g. 3"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Price (VND) *" styleClass="field-label"/>
                <TextField fx:id="priceField"
                           promptText="e.g. 810000"
                           styleClass="input-field"/>
            </VBox>
        </HBox>

        <VBox spacing="2.0">
            <Label text="Description" styleClass="field-label"/>
            <TextArea fx:id="descriptionArea"
                      promptText="Optional package details"
                      prefRowCount="3"
                      wrapText="true"
                      styleClass="input-field"/>
        </VBox>
    </VBox>

    <Label fx:id="validationLabel"
           text=""
           managed="false"
           visible="false"
           wrapText="true"
           styleClass="validation-message"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="secondary-button"/>
        <Button fx:id="saveButton"
                text="Save Package"
                onAction="#handleSave"
                styleClass="action-primary-button"/>
    </HBox>
</VBox>
